{
  "name": "freedam-dao",
  "version": "0.1.0",
  "description": "Free Decentralized Autonomous Movement — open-source civic governance",
  "private": true,
  "scripts": {
    "contracts:install": "cd contracts && npm install",
    "contracts:compile": "cd contracts && npx hardhat compile",
    "contracts:test": "cd contracts && npx hardhat test",
    "contracts:deploy:optimism-sepolia": "cd contracts && npx hardhat run scripts/deploy.js --network optimismSepolia",
    "contracts:deploy:optimism": "cd contracts && npx hardhat run scripts/deploy.js --network optimism",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "install:all": "npm run contracts:install && npm run frontend:install",
    "dev": "npm run frontend:dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FREEDAM-DAO/freedam-dao"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^4.9.6",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.1",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}

# FREEDAM DAO Environment Variables

# === Optimism Networks (Primary) ===
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
OPTIMISM_MAINNET_RPC_URL=https://mainnet.optimism.io

# Private key for deployment (never commit this!)
PRIVATE_KEY=0x...

# Etherscan API key (used for both Ethereum and Optimism verification)
ETHERSCAN_API_KEY=...

# === Optional: Frontend ===
NEXT_PUBLIC_APP_NAME=FREEDAM DAO
NEXT_PUBLIC_CHAIN_ID=11155420   # Optimism Sepolia (use 10 for mainnet)
# FREEDAM DAO — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file!

# Wallet private key (use a BURNER wallet for testnet — never your main wallet)
PRIVATE_KEY=your_burner_wallet_private_key_here

# RPC URLs (defaults are already in hardhat.config.js)
# Uncomment and override if needed:
# OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io
# OPTIMISM_MAINNET_RPC_URL=https://mainnet.optimism.io
# SEPOLIA_RPC_URL=https://rpc.sepolia.org
# MAINNET_RPC_URL=https://eth.llamarpc.com